# Este arquivo e copiado automaticamente para .env pelo START.bat na
# primeira execucao, com os segredos (NEXTAUTH_SECRET, CRON_SECRET) ja
# substituidos por valores aleatorios. Voce nao precisa editar nada para
# rodar localmente — os valores abaixo ja funcionam prontos.

# ---------------------------------------------------------------------------
# BANCO DE DADOS — SQLite local (arquivo em prisma/dev.db)
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# NEXTAUTH
# ---------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="troque-por-um-segredo-aleatorio"

# ---------------------------------------------------------------------------
# EMAIL (opcional — Resend, https://resend.com)
# Sem chave, os e-mails de notificacao simplesmente nao sao enviados
# (o resto do app funciona normalmente).
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Detonados Games <notificacoes@detonados.games>"

# ---------------------------------------------------------------------------
# WEB PUSH (opcional — gere com: npm run generate:vapid)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# Usado apenas se voce chamar manualmente as rotas /api/cron/* por HTTP
# (o agendador local em src/scripts/local-scheduler.ts nao precisa disso —
# ele chama as funcoes direto, sem passar por HTTP).
# ---------------------------------------------------------------------------
CRON_SECRET="troque-por-um-segredo-aleatorio"
