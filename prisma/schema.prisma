// Prisma schema — Detonados Games
// Dialeto SQLite (compatível com Turso/libsql). SQLite não suporta enums
// nativamente, então usamos String com valores validados via Zod/TS
// (veja src/lib/constants.ts e src/lib/roles.ts para as listas de valores
// permitidos).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// AUTENTICAÇÃO (compatível com NextAuth, caso provedores OAuth sejam
// adicionados no futuro; hoje o login por credenciais grava direto em User)
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String?   @unique
  emailVerified DateTime?
  image        String?
  passwordHash String?

  // valores: USER | MODERATOR | ADMIN (veja src/lib/roles.ts)
  role  String @default("USER")

  xp    Int    @default(0)
  level Int    @default(1)
  locale String @default("pt-BR")

  // Controle de XP diário (login) — veja src/lib/xp.ts
  lastDailyXpAt DateTime?

  // Loja de pontos: pontos disponíveis = floor(xp / 100) - pointsSpent
  pointsSpent Int @default(0)

  // Personalização equipada (itens comprados na loja) — veja src/lib/shop.ts
  nameColor      String?
  equippedFrame  String?
  equippedAvatar String?

  createdAt DateTime @default(now())

  accounts        Account[]
  sessions        Session[]
  achievements    UserAchievement[]
  notifications   Notification[]
  notificationPreference NotificationPreference?
  pushSubscriptions PushSubscription[]
  hardwareProfile HardwareProfile?
  comments        Comment[]
  gameViews       GameView[]
  likes           Like[]
  ratings         Rating[]
  savedGames      SavedGame[]
  purchases       UserPurchase[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// CATÁLOGO DE JOGOS
// ---------------------------------------------------------------------------

model Game {
  id     String @id @default(cuid())
  slug   String @unique

  steamAppId Int? @unique

  title            String
  headerImage      String?
  coverImage       String?
  shortDescription String?
  detonado         String? // conteúdo do walkthrough (markdown simples)

  platforms String // JSON array, ex: ["PC","PS5"]
  genres    String? // JSON array de strings

  minRequirements    String? // JSON: { os, cpu, gpu, ramGb, storageGb } (PC)
  recRequirements    String? // JSON: { os, cpu, gpu, ramGb, storageGb } (PC)
  mobileRequirements String? // JSON: { iosVersion, androidVersion, ramGb, storageGb, estimated }

  protonDbTier String? // borked | bronze | silver | gold | platinum | native

  // valores: DRAFT | SCHEDULED | PUBLISHED
  releaseStatus String    @default("PUBLISHED")
  scheduledFor  DateTime?
  // valores: MORNING | AFTERNOON | EVENING
  shift         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments   Comment[]
  views      GameView[]
  likes      Like[]
  ratings    Rating[]
  savedBy    SavedGame[]

  @@index([releaseStatus, shift, scheduledFor])
}

model GameView {
  id       String   @id @default(cuid())
  userId   String
  gameId   String
  viewedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId, gameId])
  @@index([gameId])
}

model Comment {
  id        String   @id @default(cuid())
  gameId    String
  userId    String
  content   String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameId, hidden, createdAt])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  value     Int // 1 a 5
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
}

model SavedGame {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// GAMIFICAÇÃO
// ---------------------------------------------------------------------------

model Achievement {
  id          String @id @default(cuid())
  key         String @unique
  name        String
  description String
  // valores: COMUM | RARA | EPICA | LENDARIA
  rarity      String
  xpReward    Int
  icon        String?

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

// ---------------------------------------------------------------------------
// LOJA DE PONTOS
// ---------------------------------------------------------------------------

model ShopItem {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String
  // valores: AVATAR | FRAME | NAME_COLOR
  type        String
  cost        Int // em Pontos (100 XP = 1 Ponto)
  // AVATAR: emoji/ícone: FRAME: cor da borda (hex); NAME_COLOR: cor do nome (hex)
  value       String
  available   Boolean @default(true)

  purchases UserPurchase[]
}

model UserPurchase {
  id          String   @id @default(cuid())
  userId      String
  itemId      String
  purchasedAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

// ---------------------------------------------------------------------------
// NOTIFICAÇÕES
// ---------------------------------------------------------------------------

model Notification {
  id      String @id @default(cuid())
  userId  String
  // valores: ACHIEVEMENT | NEW_GAME | LEVEL_UP | SYSTEM
  type    String
  title   String
  message String
  read    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique

  inApp Boolean @default(true)
  email Boolean @default(true)
  push  Boolean @default(false)

  newGames     Boolean @default(true)
  achievements Boolean @default(true)
  levelUp      Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// HARDWARE
// ---------------------------------------------------------------------------

model HardwareProfile {
  id     String  @id @default(cuid())
  userId String  @unique
  cpu    String?
  gpu    String?
  ramGb  Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// CONFIGURAÇÕES DO SITE (editáveis pelo painel de administrador)
// ---------------------------------------------------------------------------

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
